# ──────────────────────────────────────────────────────────────
# AWS Serverless deployment configuration (CDK)
#
# Copy to `.env` and fill in YOUR OWN values. Never commit the real `.env`.
# All values below are generic placeholders — replace every one of them.
#
# Only DATABASE_URL is strictly required. Domain/certificate vars are optional:
# omit them to use the default API Gateway and CloudFront URLs.
# ──────────────────────────────────────────────────────────────

# ── Target AWS account & region ──
# Used by the CDK app and must match the account/region you bootstrapped.
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ── Database (required) ──
# Any PostgreSQL reachable from Lambda (Neon pooled endpoint recommended).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── CORS ──
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# ── Custom domains (optional — commented out by default) ──
# Leave these UNSET to deploy with the default API Gateway (execute-api) URL
# and the default CloudFront (*.cloudfront.net) URL. No Route 53 hosted zone or
# certificate is required in that case.
#
# To use custom domains, uncomment and set the relevant values below. The CDK
# validates combinations and fails with a clear message if something required
# is missing. Rules:
#   - API_DOMAIN           requires CERTIFICATE_ARN (regional, see below).
#   - CDN_DOMAIN           requires CLOUDFRONT_CERTIFICATE_ARN (us-east-1), OR
#                          a HOSTED_ZONE_ID so one is requested + DNS-validated.
#   - Any custom domain    requires HOSTED_ZONE_ID for its Route 53 DNS records.
#
# API_DOMAIN=api.example.com
# CDN_DOMAIN=cdn.example.com
# HOSTED_ZONE_ID=ZXXXXXXXXXXXXX
#
# Regional ACM certificate for the API Gateway custom domain. Must be in the
# SAME region as the API Gateway (CDK_DEFAULT_REGION).
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
#
# us-east-1 ACM certificate for the CloudFront custom domain. CloudFront ALWAYS
# requires its certificate in us-east-1, regardless of CDK_DEFAULT_REGION — this
# is a DIFFERENT certificate from CERTIFICATE_ARN above. Omit it and provide
# HOSTED_ZONE_ID to have the CertificateStack request + DNS-validate one for you.
# CLOUDFRONT_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/11111111-1111-1111-1111-111111111111

# ── Resource naming ──
# Prefix applied to S3 bucket names and similar resources.
BUCKET_PREFIX=classroomio

# ── Email (Amazon SES) ──
# Default sender; the domain must be a verified SES identity in your account.
EMAIL_FROM="Your Org" <notify@example.com>

# ── Monitoring (optional) ──
# Email address to receive CloudWatch alarm notifications.
ALARM_EMAIL=
