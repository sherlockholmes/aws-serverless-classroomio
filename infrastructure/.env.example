# ──────────────────────────────────────────────────────────────
# AWS Serverless deployment configuration (CDK)
#
# Copy to `.env` and fill in YOUR OWN values. Never commit the real `.env`.
# All values below are generic placeholders — replace every one of them.
#
# Only DATABASE_URL is strictly required. Domain/certificate vars are optional:
# omit them to use the default API Gateway and CloudFront URLs.
# ──────────────────────────────────────────────────────────────

# ── Target AWS account & region ──
# Used by the CDK app and must match the account/region you bootstrapped.
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ── Database (required) ──
# Any PostgreSQL reachable from Lambda (Neon pooled endpoint recommended).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── CORS ──
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# ── Custom domains (optional) ──
# Leave unset to use the default API Gateway / CloudFront URLs.
# If set, you must also provide HOSTED_ZONE_ID and the matching ACM certificate.
API_DOMAIN=api.example.com
CDN_DOMAIN=cdn.example.com
HOSTED_ZONE_ID=ZXXXXXXXXXXXXX
# ACM certificate for the API domain (same region as the API Gateway):
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000

# ── Resource naming ──
# Prefix applied to S3 bucket names and similar resources.
BUCKET_PREFIX=classroomio

# ── Email (Amazon SES) ──
# Default sender; the domain must be a verified SES identity in your account.
EMAIL_FROM="Your Org" <notify@example.com>

# ── Monitoring (optional) ──
# Email address to receive CloudWatch alarm notifications.
ALARM_EMAIL=
